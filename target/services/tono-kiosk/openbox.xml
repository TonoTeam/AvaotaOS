<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus><focusNew>yes</focusNew><followMouse>no</followMouse></focus>
  <desktops><number>1</number></desktops>
  <keyboard>
    <keybind key="A-F4"><action name="Close"/></keybind>
    <keybind key="A-Tab"><action name="NextWindow"/></keybind>
  </keyboard>
  <applications>
    <application class="tono-canvas"><decor>no</decor></application>
    <!-- The app temporarily remaps its override-redirect window when a modal
         opens. Keep dialogs above that newly managed parent. -->
    <application type="dialog"><layer>above</layer></application>
  </applications>
</openbox_config>
