[Unit]
Description=Tono Canvas kiosk session
After=systemd-user-sessions.service systemd-logind.service apparmor.service
Wants=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=avaota
PAMName=login
# Xorg needs the primary DRM node to pass authenticated DRI3 fds to clients.
# The app reads the touchscreen's evdev node itself for the canvas (input):
# libinput/Xorg hand touch motion to clients one touch frame late.
SupplementaryGroups=video render input
EnvironmentFile=-/etc/default/tono-kiosk
Environment=XDG_SESSION_TYPE=x11 XDG_SESSION_DESKTOP=tono-kiosk XDG_CURRENT_DESKTOP=Openbox
Environment=XDG_SEAT=seat0 XDG_VTNR=1
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/local/libexec/tono-kiosk-start
Restart=always
RestartSec=5
# No ExecStop=: systemd would hang up tty1 for it, ending Xorg before the app
# saves. SIGTERM reaches only tono-kiosk-start, which waits for the app first.
KillMode=mixed
TimeoutStopSec=100

[Install]
WantedBy=multi-user.target
