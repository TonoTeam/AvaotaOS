# Tono DeepSeek Harness user service
[Unit]
Description=DeepSeek Harness Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/deepseek-workspace
ExecStart=%h/.local/opt/deepseek-harness/current/bin/tono-dsh-server
RuntimeDirectory=tono-deepseek-harness
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
